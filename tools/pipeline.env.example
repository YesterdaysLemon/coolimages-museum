# Copy to tools/pipeline.env (gitignored). Values are Proton Pass references,
# resolved by `pass-cli run` at runtime; never put a raw key here.
# Store the key as a Login item titled "coolimages / ANTHROPIC_API_KEY" in the
# api_keys vault (key in the password field), then resolve its IDs in the
# agent session: pass://<share id>/<item id>/password
ANTHROPIC_API_KEY=pass://SHARE_ID/ITEM_ID/password
